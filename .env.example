# AnadoluSMS — örnek ortam değişkenleri
# Sadece kullandığınız sağlayıcı(lar)ın bilgilerini doldurmanız yeterli.

# --- İleti Merkezi (iletimerkezi.com) ---
# panel.iletimerkezi.com > Ayarlar > Güvenlik > API Erişimi
ILETIMERKEZI_API_KEY=
ILETIMERKEZI_API_HASH=
ILETIMERKEZI_SENDER=

# --- Verimor (verimor.com.tr) ---
# Kullanıcı adı = hesabınızın 12 haneli telefon numarası (örn. 908501234567)
# Şifre = oim.verimor.com.tr/sms_settings/edit üzerinden tanımlanır
# ÖNEMLİ: Gönderim yapacağınız sunucunun IP adresini de aynı sayfada tanımlamanız gerekir,
# aksi halde "Hesabınızda izinli IP ayarları yapılmamış" hatası alırsınız.
VERIMOR_USERNAME=
VERIMOR_PASSWORD=
VERIMOR_SENDER=

# --- VatanSMS (vatansms.net) ---
VATANSMS_API_ID=
VATANSMS_API_KEY=
VATANSMS_SENDER=

# --- NetGSM (netgsm.com.tr) ---
# Ana hesap kullanıcı adı/şifresi DEĞİL — panelden oluşturulan API alt-kullanıcısı
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
